# ==============================================================================
# Project configuration for the scripts in this project
# ==============================================================================
# These scripts read this file:
#   build.sh / build.bat            BUILD_*, GC_*
#   start.sh / start.bat            REMOTE_*
#   npm run auth:portal             PORTAL_*
#
# Format:
#   - One KEY=VALUE on each line. Do not put spaces around "=".
#   - Do not put quotes around a value. Do not put a comment after a value.
#   - A line that starts with "#" is a comment.
#   - An empty value (KEY=) means "not set". The script then uses its default.
#   - Do not use "!" in a value. Windows .bat scripts remove it.
#
# Priority (the first one that has a value wins):
#   1. An argument on the command line, for example: ./build.sh upload-gc <public-url> <name>
#   2. project.config (this file)
#   3. The default value in the script
#
# This file is committed to git, so it is shared with your team. Do not put passwords or tokens in it.
# The scripts do not run this file as code. They only read KEY=VALUE lines.
# ==============================================================================


# ------------------------------------------------------------------------------
# Build (build.sh / build.bat)
# ------------------------------------------------------------------------------

# The name of the built library. The build copies build/main.js to build/<BUILD_NAME>.js and
# build/<BUILD_NAME>.js.txt.
# Default: the project folder name.
BUILD_NAME=__PROJECT_NAME__


# ------------------------------------------------------------------------------
# Upload to Google Cloud Storage (build.sh upload-gc / build.bat upload-gc)
# ------------------------------------------------------------------------------
# Prerequisites: install the Google Cloud CLI and sign in with: gcloud auth login
# The bucket must already allow public read (allUsers: Storage Object Viewer).
# The scripts do not change the access of the bucket.

# The upload target. If you set it, you can run "./build.sh upload-gc" without a URL.
# Formats: https://storage.googleapis.com/<bucket>/<path> or gs://<bucket>/<path>
#   - If the value ends with ".js", it is the file name.
#   - If not, it is a folder, and the file is <BUILD_NAME>.js in that folder.
# Example: GC_UPLOAD_URL=https://storage.googleapis.com/my-bucket/libs/
# Default: not set. Then you must give the URL on the command line.
GC_UPLOAD_URL=

# The Cache-Control header of the uploaded file.
# "no-cache" makes VertiGIS Studio Web load the new version at the next app load.
# Without it, Google Cloud Storage can serve the old version for up to 1 hour.
# Example: GC_CACHE_CONTROL=public, max-age=300
# Default: no-cache
GC_CACHE_CONTROL=no-cache


# ------------------------------------------------------------------------------
# Remote sync (start.sh remote / start.bat remote)
# ------------------------------------------------------------------------------
# Remote mode pulls origin/<branch>, then fetches it again at an interval while the dev server runs.
# It fast-forwards only. It does not change your local commits or uncommitted changes.

# Set to true to use remote mode also when you run "./start.sh" without "remote".
# Default: false
REMOTE_SYNC=false

# The branch to sync with.
# Default: not set. Then the script uses the current branch.
REMOTE_BRANCH=

# The time between two fetches, in seconds.
# Default: 5
REMOTE_INTERVAL=5


# ------------------------------------------------------------------------------
# Portal authentication (npm run auth:portal)
# ------------------------------------------------------------------------------
# If PORTAL_URL and PORTAL_CLIENT_ID both have a value, "npm run auth:portal" does not ask questions.
# It writes app/auth/portal.json and src/auth/portalConfig.json from these values.
# If one of them is empty, the script asks for the missing values.
#
# Note: these values are not secrets. The OAuth client ID is public, and the build puts it in the bundle.

# The URL of your ArcGIS Enterprise portal or ArcGIS Online organization.
# Example: PORTAL_URL=https://gis.example.com/portal
PORTAL_URL=

# The Client ID of the OAuth application that you registered in the portal
# (Content > Add Item > Application).
PORTAL_CLIENT_ID=

# The account ID (organization identifier).
# Default: if the script asks questions, it suggests the first part of the portal host name
# (for example "gis" for gis.example.com). If it does not ask questions, the default is "enterprise".
PORTAL_ACCOUNT_ID=

# The web map to show in app/app.json. Use the item ID (32 characters) or the full item URL.
# Default: not set. Then the script does not change the web map.
PORTAL_WEBMAP=

# More origins that you use for preview, separated by commas. The script shows them in the list of
# redirect URIs and allowed origins that you must add in the portal. https://localtest.me:3001 is always shown.
# Example: PORTAL_PREVIEW_ORIGINS=https://preview.example.com,https://test.example.com
PORTAL_PREVIEW_ORIGINS=https://preview.kw11.org
